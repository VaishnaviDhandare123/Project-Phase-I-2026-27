# SpeechSense AI - Environment Configuration
PROJECT_NAME="SpeechSense AI"
VERSION="1.0.0"
DEBUG=True

# Host & Ports
HOST="127.0.0.1"
PORT=8000
FRONTEND_PORT=3000

# Authentication & Security
SECRET_KEY="speechsense-ai-super-secret-production-grade-hmac-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to embedded atomic local document store if MongoDB is not running locally
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="speechsense_db"

# Deep Learning Models
DEFAULT_WHISPER_MODEL="openai/whisper-tiny"
DEVICE="cpu" # "cpu" or "cuda"

# Audio Pipeline
DEFAULT_SAMPLE_RATE=16000
MAX_UPLOAD_SIZE_MB=50
VAD_ENERGY_THRESHOLD_DB=-35.0
